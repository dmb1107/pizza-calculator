{
  "name": "pizza-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Biga Neapolitan dough calculator — Grain Craft 00, Ooni Halo Core, Gozney Tread",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p worker --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p worker --noEmit",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "test:worker": "playwright test -c playwright.worker.config.ts",
    "test:preview": "playwright test -c playwright.preview.config.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.155.0"
  }
}
